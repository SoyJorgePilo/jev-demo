# Jev (TypeSafe AI) — https://typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Claude: cli = claude -p con la sesión de Claude Code (sin API key)
CLAUDE_ENGINE=cli
MODEL_SMALL=claude-haiku-4-5
MODEL_LARGE=claude-sonnet-5-5

# Jira Cloud — token en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://TU-SITIO.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN

# Campo Team de Jira y los ids de cada equipo (final de la URL del equipo: .../jira/people/team/<id>)
